# =============================================================================
# Root .gitignore - DentalFlow / Zendenta
# =============================================================================

# User-specified exclusions
powershell.cmd
imp/
imp
temp/
.serena/

# Environment and Secret Files
.env
.env.*
.env*.local
.env.example
*.env.example
*.key
*.pem
*.cert
*.pfx
credentials.json

# Node / Next.js / Frontend
node_modules/
.next/
dist/
dist-ssr/
build/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
__v0_*
ids.indexOf(item)

# Python / FastAPI / Backend
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
.pytest_cache/
.coverage
htmlcov/
.cache/
nosetests.xml
coverage.xml
*.cover
*.log

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Data and Backups (Excel pilot / locks)
backend/data/backups/
backend/data/*.xlsx.lock
backend/data/*.lock
*.lock
!package-lock.json
!pnpm-lock.yaml

# OS and Editor
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
